{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "allInOne",
  "description": "This is a container containing an array of vehicles",
  "type": "object",
  "properties": {
    "vehicles": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/definitions/vehicle"
          },
          {
            "$ref": "#/definitions/car"
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [],
  "additionalProperties": false,
  "definitions": {
    "vehicle": {
      "description": "A vehicle",
      "type": "object",
      "properties": {
        "hasWheels": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "car": {
      "description": "a Car",
      "type": "object",
      "properties": {
        "type": {
          "description": "Type of car",
          "type": "string",
          "enum": [
            "suv",
            "hatchback",
            "sport",
            "sedan"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "bmw": {
      "description": "a BMW",
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
}