{
  "name": "openapi-transformer",
  "version": "0.11.0",
  "description": "Transforms OpenAPI Schemas to other formats like MarkDown and PlantUML",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/armand-janssen/openapi-transformer"
  },
  "homepage": "https://github.com/armand-janssen/openapi-transformer",
  "scripts": {
    "test": "nyc mocha",
    "test-debug": "mocha --inspect-brk",
    "lint": "eslint . --ignore-pattern node_modules/",
    "lintfix": "eslint . --fix"
  },
  "nyc": {
    "all": true,
    "check-coverage": true,
    "lines": 95,
    "branches": 95,
    "include": [
      "src/**/*.js"
    ]
  },
  "keywords": [
    "openapi",
    "markdown",
    "md",
    "yaml",
    "transformer",
    "generator",
    "plantuml"
  ],
  "author": "Armand Janssen",
  "license": "MIT",
  "dependencies": {
    "commander": "^2.20.3",
    "yaml": "^2.2.2"
  },
  "bin": {
    "openapi-transformer": "src/cli.js"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "eslint": "^8.3.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-classes": "^0.1.1",
    "eslint-plugin-import": "^2.17.2",
    "eslint-plugin-promise": "^4.0.1",
    "mocha": "^9.1.3",
    "nyc": "^15.1.0",
    "sinon": "^7.5.0"
  },
  "files": [
    "src",
    "!src/**/*.test.js"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
