{
  "name": "openapi-transformer",
  "version": "0.12.0",
  "description": "Transforms OpenAPI Schemas to other formats like MarkDown and PlantUML",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armand-janssen/openapi-transformer.git"
  },
  "homepage": "https://github.com/armand-janssen/openapi-transformer",
  "scripts": {
    "test": "nyc mocha",
    "test-debug": "mocha --inspect-brk",
    "lint": "eslint . --ignore-pattern node_modules/",
    "lintfix": "eslint . --fix"
  },
  "nyc": {
    "all": true,
    "check-coverage": true,
    "lines": 95,
    "branches": 95,
    "include": [
      "src/**/*.js"
    ]
  },
  "keywords": [
    "openapi",
    "markdown",
    "md",
    "yaml",
    "transformer",
    "generator",
    "plantuml"
  ],
  "author": "Armand Janssen",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.1.0",
    "yaml": "^2.2.2"
  },
  "bin": {
    "openapi-transformer": "src/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "chai": "^4.2.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sinon": "^7.5.0"
  },
  "files": [
    "src",
    "!src/**/*.test.js"
  ],
  "engines": {
    "node": ">=22.13"
  }
}
