    },
    "car": {
      "type": "object",
      "properties": {
        "type": {
          "description": "Type of car",
          "type": "string",
          "enum": [
            "suv",
            "hatchback",
            "sport",
            "sedan"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "bmw": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
